{
  "schemaVersion": 1,
  "id": "mekanismgenerators",
  "version": "${version}",

  "name": "Mekanism: Generators",
  "description": "Generators module for Mekanism",
  "authors": [
    "Aidancbrady", "Thommy101", "Thiakil", "pupnewfster", "dizzyd",
    "AlphaMode", "BluSpring"
  ],
  "contact": {
    "sources": "https://github.com/Bomb-Shelter/Mekanism"
  },

  "license": "MIT",
  "icon": "logo.png",
  "mixins": [
    "mekanism.mixins.json"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "mekanism.generators.common.MekanismGenerators"
    ],
    "client": [
      "mekanism.generators.client.GeneratorsClient"
    ],
    "fabric-datagen": [
    ],
    "emi": [
      "mekanism.generators.client.recipe_viewer.emi.GeneratorsEmi"
    ],
    "jei_mod_plugin": [
      "mekanism.generators.client.recipe_viewer.jei.GeneratorsJEI"
    ]
  },
  "accessWidener": "mekanism.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": ">=${fabric_version}",
    "minecraft": ">=${minecraft_version}",
    "mekanism": ">=${version}"
  },
  "custom": {
    "banner": "logo.png"
  }
}